# THREATCAST environment contract.
# Copy to .env and adjust. NEVER commit real secrets.

APP_ENV=development

# --- Services / Ports (GLOBAL PORT CONTRACT - do not change) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# --- Database ---
DATABASE_URL=postgresql://threatcast:threatcast@localhost:5432/threatcast

# --- ML ---
ML_MODEL_PATH=./ml/artifacts/world_model.pt
ML_METADATA_PATH=./ml/artifacts/model_metadata.json
ML_DEVICE=auto
ML_ARTIFACTS_DIR=./ml/artifacts
ML_SEQUENCE_LENGTH=5
ML_PREDICTION_HORIZON=3

# --- Backend API ---
# Comma-separated list of allowed browser origins (FastAPI CORSMiddleware)
CORS_ORIGINS=http://localhost:5173

# --- Time window engine ---
TIME_WINDOW_SECONDS=10

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=500

# --- Logging ---
LOG_LEVEL=INFO
